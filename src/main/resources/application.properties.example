# PostgreSQL runtime configuration. Override these with environment variables when needed.
spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:postgresql://localhost:8100/teamdb}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME:${DB_USERNAME:teamuser}}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD:${DB_PASSWORD:}}
spring.datasource.driver-class-name=org.postgresql.Driver

# Finnhub configuration
finnhub.api-key=${FINNHUB_API_KEY:}

#Refresh configuration
finnhub.refresh-all=true
finnhub.max-retries=2
finnhub.retry-backoff-ms=2500
